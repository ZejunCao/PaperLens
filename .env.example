# pymupdf | mineru | mineru_api
PAPERLENS_PARSER=mineru
PAPERLENS_MINERU_BACKEND=pipeline
PAPERLENS_MINERU_DEVICE=cuda
PAPERLENS_MINERU_LANG=en
# huggingface | modelscope
PAPERLENS_MINERU_MODEL_SOURCE=modelscope

# Windows 上 uv sync --extra mineru 常会装到 CPU 版 torch。
# 若 python -c "import torch; print(torch.cuda.is_available())" 为 False：
#   uv pip install torch torchvision --index-url https://download.pytorch.org/whl/cu128

# 仅 parser=mineru_api 时需要（mineru.net 精准解析 Token）
PAPERLENS_MINERU_API_TOKEN=
PAPERLENS_MINERU_API_BASE=https://mineru.net
PAPERLENS_MINERU_API_MODEL=vlm
